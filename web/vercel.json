{
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/drive/sync-file?mcp_route=oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/drive/sync-file?mcp_route=oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/drive/sync-file?mcp_route=oauth-authorization-server"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/drive/sync-file?mcp_route=resource"
    },
    {
      "source": "/api/mcp/grants",
      "destination": "/api/drive/sync-file?mcp_route=grants"
    },
    {
      "source": "/api/mcp/oauth/authorization-server",
      "destination": "/api/drive/sync-file?mcp_route=oauth-authorization-server"
    },
    {
      "source": "/api/mcp/oauth/authorize",
      "destination": "/api/drive/sync-file?mcp_route=oauth-authorize"
    },
    {
      "source": "/api/mcp/oauth/google/callback",
      "destination": "/api/drive/sync-file?mcp_route=oauth-google-callback"
    },
    {
      "source": "/api/mcp/oauth/protected-resource",
      "destination": "/api/drive/sync-file?mcp_route=oauth-protected-resource"
    },
    {
      "source": "/api/mcp/oauth/register",
      "destination": "/api/drive/sync-file?mcp_route=oauth-register"
    },
    {
      "source": "/api/mcp/oauth/revoke",
      "destination": "/api/drive/sync-file?mcp_route=oauth-revoke"
    },
    {
      "source": "/api/mcp/oauth/token",
      "destination": "/api/drive/sync-file?mcp_route=oauth-token"
    },
    {
      "source": "/api/internal/mcp-cleanup",
      "destination": "/api/drive/sync-file?mcp_route=cleanup"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/mcp-cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self'; frame-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
